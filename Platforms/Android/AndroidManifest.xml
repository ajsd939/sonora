<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
	<uses-permission android:name="android.permission.INTERNET" />
	<uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

	<!--
		The service is what keeps the stream alive once the page is off screen; from
		Android 14 a service of type mediaPlayback is refused without both of these.
	-->
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
	<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

	<!-- The wake and Wi-Fi locks the service holds so the stream survives the screen off. -->
	<uses-permission android:name="android.permission.WAKE_LOCK" />

	<!--
		Listing the listener's own files. From Android 13 audio has a permission of its own;
		the broad storage one only applies to the older releases the app still supports.
	-->
	<uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
	<uses-permission
		android:name="android.permission.READ_EXTERNAL_STORAGE"
		android:maxSdkVersion="32" />

	<application
		android:label="Sonora"
		android:icon="@mipmap/ic_launcher"
		android:roundIcon="@mipmap/ic_launcher_round" />
</manifest>
