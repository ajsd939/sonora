<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android;net10.0-windows10.0.19041.0</TargetFrameworks>
		<OutputType>Exe</OutputType>
		<RootNamespace>Sonora</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<ApplicationTitle>Sonora</ApplicationTitle>
		<ApplicationId>in.sonora.app</ApplicationId>

		<!--
			Beta: the numbers stay below 1.0 until the library, playlists and background
			playback have all been lived with for a while.
		-->
		<ApplicationDisplayVersion>0.9</ApplicationDisplayVersion>
		<ApplicationVersion>9</ApplicationVersion>
		<Version>0.9.0-beta</Version>

		<!--
			The HybridWebView JavaScript->C# dispatcher and YoutubeExplode's YouTube
			playlist parsers both run through reflection, so full trimming would
			stub out the members they look up.
		-->
		<PublishTrimmed>false</PublishTrimmed>
		<TrimMode>copyused</TrimMode>

		<!-- Unpackaged Windows build: runs with `dotnet build -t:Run`, no dev cert / MSIX. -->
		<WindowsPackageType Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">None</WindowsPackageType>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.19041.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="$(MauiVersion)" />
		<PackageReference Include="YoutubeExplode" Version="6.6.3" />
		<PackageReference Include="YouTubeMusicAPI" Version="3.1.0" />
	</ItemGroup>

	<ItemGroup>
		<!--
			The web bundle shipped to the device. LogicalName strips the Resources\Raw
			prefix so the HybridWebView root resolves as wwwroot/index.html.
		-->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

</Project>
